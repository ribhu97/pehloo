OPENROUTER_API_KEY=sk-or-...
PEHLOO_DEFAULT_MODEL=anthropic/claude-sonnet-4-5
PEHLOO_MAX_STEPS_PER_TASK=15
PEHLOO_OUTPUT_DIR=./reports
PEHLOO_HEADLESS=true

# Optional shared login credentials — injected into every persona's task prompt
# when present. Leave blank if your target app doesn't require login.
PEHLOO_LOGIN_EMAIL=
PEHLOO_LOGIN_PASSWORD=
